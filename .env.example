# ============================================================
# Qualys AI Analyst Copilot - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- AWS Configuration (Amazon Bedrock) ---
AWS_REGION=us-east-1
AWS_PROFILE=default
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# --- Qualys API Credentials ---
QUALYS_API_URL=https://qualysapi.qualys.com
QUALYS_USERNAME=your_qualys_username
QUALYS_PASSWORD=your_qualys_password

# --- Application Settings ---
LOG_LEVEL=INFO
INPUT_CSV=data/qualys_export.csv
OUTPUT_DIR=reports
MAX_TOKENS=4096
